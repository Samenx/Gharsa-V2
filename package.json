{
  "name": "gharsa",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend/src backend/src backend/database backend/tests tests *.js *.json",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8"
  }
}
